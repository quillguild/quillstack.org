/node_modules/

# Built by `npm run packages` from the READMEs of the package repositories: what is here is
# whatever they said the last time somebody built, which is not a thing to keep in git.
/docs/packages/*.md

# VitePress leaves these wherever it is run from. A pattern with a slash inside it is anchored
# to this file, so these need the `**` to match the copy under `docs/` as well.
**/.vitepress/cache/
**/.vitepress/dist/

.DS_Store
